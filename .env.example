# ============================================================
# GigSetu — India's Cooperative Workforce Operating System
# Environment configuration
# Copy to `.env` and fill in. NEVER commit real keys.
# ============================================================

# ---------- Database ----------
# Two options — pick per environment.
#
# LOCAL / self-hosted (writable, persistent disk):
DATABASE_URL="file:../db/custom.db"
#
# SERVERLESS (Vercel, Cloudflare Workers) — a `file:` database CANNOT work there
# (read-only, non-shared filesystem). Use libSQL/Turso, which speaks the same
# SQLite dialect, so no schema or query changes are needed:
#   turso db create gigsetu
#   turso db tokens create
#   DATABASE_URL="libsql://your-db.turso.io"
#   DATABASE_AUTH_TOKEN="your-token"
# DATABASE_AUTH_TOKEN=""
#
# Verify any deployment at once:  curl -i https://your-app.vercel.app/api/health
# The UI also shows a banner when the database is unreachable.

# ---------- Application ----------
# Secret used to sign the httpOnly demo session cookie (spec §47).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=""

# Public origin used for absolute links in receipts / passports.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------- GeoApify (spec §42 Map & Geo-Spatial System) ----------
# All five are OPTIONAL. When a key is missing, unreachable, rate-limited or the
# judging hall is offline, GigSetu falls back deterministically to the built-in
# Pune service grid (src/lib/geoapify.ts) so the demo NEVER dies.
# Keys are per-product: MyProjects -> API Keys -> pick the product.
GEOAPIFY_AUTOCOMPIFY_KEY=""        # Address Autocomplete  -> /api/geo/autocomplete
GEOAPIFY_GEOCODING_KEY=""          # Geocoding             -> /api/geo/geocode
GEOAPIFY_REVERSE_GEOCODING_KEY=""  # Reverse Geocoding     -> /api/geo/reverse
GEOAPIFY_ROUTE_MATRIX_KEY=""       # Route Matrix          -> /api/geo/route-matrix
GEOAPIFY_ROUTING_KEY=""            # Routing               -> /api/geo/route

# Set to "0" to force the offline fallback even when keys are present
# (useful for a rehearsed, network-free SIH demo).
GEOAPIFY_ENABLED="1"

# ---------- AI (spec §63 — no fake AI) ----------
# Optional LLM for request understanding. Without it GigSetu uses the
# deterministic heuristic analyzers, which are the offline-safe path and produce
# the same classification as the matching engine.
ZAI_API_KEY=""

# ---------- Payments (spec §65 — Demo Payment mode only) ----------
# GigSetu NEVER contacts a real gateway. These are documentation placeholders.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# ---------- WhatsApp Business API (spec §14 — designed for authorized integration) ----------
# The prototype ships a simulated thread. These are documentation placeholders.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# ---------- Government / cooperative registries (spec §4, §64) ----------
# Intentionally blank. GigSetu never claims live government access; every
# government-facing surface is labelled "Designed for Authorized Integration".
GOV_REGISTRY_BASE_URL=""
E_SHRAM_API_BASE_URL=""
